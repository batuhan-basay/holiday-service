{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NagerDate": {
    "BaseAddress": "https://date.nager.at/",
    "Timeout": "00:00:10",
    "CacheDuration": "12:00:00",
    "HistoricalCacheDuration": "7.00:00:00",
    "RetryCount": 3
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "ApiKeys": {
    "Enabled": true,
    "Clients": []
  }
}
